---
kind: ObjectType
version: v1
definition:
  name: products
  fields:
    - name: category
      type: varchar!
    - name: created_at
      type: timestamp
    - name: description
      type: text
    - name: price
      type: numeric!
    - name: product_id
      type: int4!
    - name: product_name
      type: varchar!
    - name: stock_quantity
      type: int4
  graphql:
    typeName: products
    inputTypeName: products_input
  dataConnectorTypeMapping:
    - dataConnectorName: mypostgres
      dataConnectorObjectType: products

---
kind: TypePermissions
version: v1
definition:
  typeName: products
  permissions:
    - role: admin
      output:
        allowedFields:
          - category
          - created_at
          - description
          - price
          - product_id
          - product_name
          - stock_quantity

---
kind: BooleanExpressionType
version: v1
definition:
  name: products_bool_exp
  operand:
    object:
      type: products
      comparableFields:
        - fieldName: category
          booleanExpressionType: varchar_bool_exp
        - fieldName: created_at
          booleanExpressionType: timestamp_bool_exp
        - fieldName: description
          booleanExpressionType: text_bool_exp
        - fieldName: price
          booleanExpressionType: numeric_bool_exp
        - fieldName: product_id
          booleanExpressionType: int4_bool_exp
        - fieldName: product_name
          booleanExpressionType: varchar_bool_exp
        - fieldName: stock_quantity
          booleanExpressionType: int4_bool_exp
      comparableRelationships:
        - relationshipName: orderitems
        - relationshipName: reviews
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: products_bool_exp

---
kind: AggregateExpression
version: v1
definition:
  name: products_agg_exp
  operand:
    object:
      aggregatedType: products
      aggregatableFields:
        - fieldName: category
          aggregateExpression: varchar_agg_exp
        - fieldName: created_at
          aggregateExpression: timestamp_agg_exp
        - fieldName: description
          aggregateExpression: text_agg_exp
        - fieldName: price
          aggregateExpression: numeric_agg_exp
        - fieldName: product_id
          aggregateExpression: int4_agg_exp
        - fieldName: product_name
          aggregateExpression: varchar_agg_exp
        - fieldName: stock_quantity
          aggregateExpression: int4_agg_exp
  count:
    enable: true
  graphql:
    selectTypeName: products_agg_exp

---
kind: OrderByExpression
version: v1
definition:
  name: products_order_by_exp
  operand:
    object:
      orderedType: products
      orderableFields:
        - fieldName: category
          orderByExpression: varchar_order_by_exp
        - fieldName: created_at
          orderByExpression: timestamp_order_by_exp
        - fieldName: description
          orderByExpression: text_order_by_exp
        - fieldName: price
          orderByExpression: numeric_order_by_exp
        - fieldName: product_id
          orderByExpression: int4_order_by_exp
        - fieldName: product_name
          orderByExpression: varchar_order_by_exp
        - fieldName: stock_quantity
          orderByExpression: int4_order_by_exp
      orderableRelationships: []
  graphql:
    expressionTypeName: products_order_by_exp

---
kind: Model
version: v2
definition:
  name: products
  objectType: products
  source:
    dataConnectorName: mypostgres
    collection: products
  filterExpressionType: products_bool_exp
  aggregateExpression: products_agg_exp
  orderByExpression: products_order_by_exp
  graphql:
    selectMany:
      queryRootField: products
      subscription:
        rootField: products
    selectUniques:
      - queryRootField: products_by_product_id
        uniqueIdentifier:
          - product_id
        subscription:
          rootField: products_by_product_id
    filterInputTypeName: products_filter_input
    aggregate:
      queryRootField: products_aggregate
      subscription:
        rootField: products_aggregate

---
kind: ModelPermissions
version: v1
definition:
  modelName: products
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

---
kind: Relationship
version: v1
definition:
  name: orderitems
  sourceType: products
  target:
    model:
      name: orderitems
      relationshipType: Array
      aggregate:
        aggregateExpression: orderitems_agg_exp
  mapping:
    - source:
        fieldPath:
          - fieldName: product_id
      target:
        modelField:
          - fieldName: product_id
  graphql:
    aggregateFieldName: orderitems_aggregate

---
kind: Relationship
version: v1
definition:
  name: reviews
  sourceType: products
  target:
    model:
      name: reviews
      relationshipType: Array
      aggregate:
        aggregateExpression: reviews_agg_exp
  mapping:
    - source:
        fieldPath:
          - fieldName: product_id
      target:
        modelField:
          - fieldName: product_id
  graphql:
    aggregateFieldName: reviews_aggregate

