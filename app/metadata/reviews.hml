---
kind: ObjectType
version: v1
definition:
  name: reviews
  fields:
    - name: comment
      type: text
    - name: embedding
      type: vector
    - name: product_id
      type: int4!
    - name: rating
      type: int4!
    - name: review_date
      type: timestamp
    - name: review_id
      type: int4!
    - name: user_id
      type: int4!
  graphql:
    typeName: reviews
    inputTypeName: reviews_input
  dataConnectorTypeMapping:
    - dataConnectorName: mypostgres
      dataConnectorObjectType: reviews

---
kind: TypePermissions
version: v1
definition:
  typeName: reviews
  permissions:
    - role: admin
      output:
        allowedFields:
          - comment
          - embedding
          - product_id
          - rating
          - review_date
          - review_id
          - user_id

---
kind: BooleanExpressionType
version: v1
definition:
  name: reviews_bool_exp
  operand:
    object:
      type: reviews
      comparableFields:
        - fieldName: comment
          booleanExpressionType: text_bool_exp
        - fieldName: embedding
          booleanExpressionType: vector_bool_exp
        - fieldName: product_id
          booleanExpressionType: int4_bool_exp
        - fieldName: rating
          booleanExpressionType: int4_bool_exp
        - fieldName: review_date
          booleanExpressionType: timestamp_bool_exp
        - fieldName: review_id
          booleanExpressionType: int4_bool_exp
        - fieldName: user_id
          booleanExpressionType: int4_bool_exp
      comparableRelationships:
        - relationshipName: product
        - relationshipName: user
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: reviews_bool_exp

---
kind: AggregateExpression
version: v1
definition:
  name: reviews_agg_exp
  operand:
    object:
      aggregatedType: reviews
      aggregatableFields:
        - fieldName: comment
          aggregateExpression: text_agg_exp
        - fieldName: embedding
          aggregateExpression: vector_agg_exp
        - fieldName: product_id
          aggregateExpression: int4_agg_exp
        - fieldName: rating
          aggregateExpression: int4_agg_exp
        - fieldName: review_date
          aggregateExpression: timestamp_agg_exp
        - fieldName: review_id
          aggregateExpression: int4_agg_exp
        - fieldName: user_id
          aggregateExpression: int4_agg_exp
  count:
    enable: true
  graphql:
    selectTypeName: reviews_agg_exp

---
kind: OrderByExpression
version: v1
definition:
  name: reviews_order_by_exp
  operand:
    object:
      orderedType: reviews
      orderableFields:
        - fieldName: comment
          orderByExpression: text_order_by_exp
        - fieldName: embedding
          orderByExpression: vector_order_by_exp
        - fieldName: product_id
          orderByExpression: int4_order_by_exp
        - fieldName: rating
          orderByExpression: int4_order_by_exp
        - fieldName: review_date
          orderByExpression: timestamp_order_by_exp
        - fieldName: review_id
          orderByExpression: int4_order_by_exp
        - fieldName: user_id
          orderByExpression: int4_order_by_exp
      orderableRelationships:
        - relationshipName: product
        - relationshipName: user
  graphql:
    expressionTypeName: reviews_order_by_exp

---
kind: Model
version: v2
definition:
  name: reviews
  objectType: reviews
  source:
    dataConnectorName: mypostgres
    collection: reviews
  filterExpressionType: reviews_bool_exp
  aggregateExpression: reviews_agg_exp
  orderByExpression: reviews_order_by_exp
  graphql:
    selectMany:
      queryRootField: reviews
      subscription:
        rootField: reviews
    selectUniques:
      - queryRootField: reviews_by_review_id
        uniqueIdentifier:
          - review_id
        subscription:
          rootField: reviews_by_review_id
    filterInputTypeName: reviews_filter_input
    aggregate:
      queryRootField: reviews_aggregate
      subscription:
        rootField: reviews_aggregate

---
kind: ModelPermissions
version: v1
definition:
  modelName: reviews
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

---
kind: Relationship
version: v1
definition:
  name: product
  sourceType: reviews
  target:
    model:
      name: products
      relationshipType: Object
  mapping:
    - source:
        fieldPath:
          - fieldName: product_id
      target:
        modelField:
          - fieldName: product_id

---
kind: Relationship
version: v1
definition:
  name: user
  sourceType: reviews
  target:
    model:
      name: users
      relationshipType: Object
  mapping:
    - source:
        fieldPath:
          - fieldName: user_id
      target:
        modelField:
          - fieldName: user_id

