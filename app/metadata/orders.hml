---
kind: ObjectType
version: v1
definition:
  name: orders
  fields:
    - name: order_date
      type: timestamp
    - name: order_id
      type: int4!
    - name: status
      type: varchar
    - name: total_amount
      type: numeric!
    - name: user_id
      type: int4!
  graphql:
    typeName: orders
    inputTypeName: orders_input
  dataConnectorTypeMapping:
    - dataConnectorName: mypostgres
      dataConnectorObjectType: orders

---
kind: TypePermissions
version: v1
definition:
  typeName: orders
  permissions:
    - role: admin
      output:
        allowedFields:
          - order_date
          - order_id
          - status
          - total_amount
          - user_id

---
kind: BooleanExpressionType
version: v1
definition:
  name: orders_bool_exp
  operand:
    object:
      type: orders
      comparableFields:
        - fieldName: order_date
          booleanExpressionType: timestamp_bool_exp
        - fieldName: order_id
          booleanExpressionType: int4_bool_exp
        - fieldName: status
          booleanExpressionType: varchar_bool_exp
        - fieldName: total_amount
          booleanExpressionType: numeric_bool_exp
        - fieldName: user_id
          booleanExpressionType: int4_bool_exp
      comparableRelationships:
        - relationshipName: orderitems
        - relationshipName: user
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: orders_bool_exp

---
kind: AggregateExpression
version: v1
definition:
  name: orders_agg_exp
  operand:
    object:
      aggregatedType: orders
      aggregatableFields:
        - fieldName: order_date
          aggregateExpression: timestamp_agg_exp
        - fieldName: order_id
          aggregateExpression: int4_agg_exp
        - fieldName: status
          aggregateExpression: varchar_agg_exp
        - fieldName: total_amount
          aggregateExpression: numeric_agg_exp
        - fieldName: user_id
          aggregateExpression: int4_agg_exp
  count:
    enable: true
  graphql:
    selectTypeName: orders_agg_exp

---
kind: OrderByExpression
version: v1
definition:
  name: orders_order_by_exp
  operand:
    object:
      orderedType: orders
      orderableFields:
        - fieldName: order_date
          orderByExpression: timestamp_order_by_exp
        - fieldName: order_id
          orderByExpression: int4_order_by_exp
        - fieldName: status
          orderByExpression: varchar_order_by_exp
        - fieldName: total_amount
          orderByExpression: numeric_order_by_exp
        - fieldName: user_id
          orderByExpression: int4_order_by_exp
      orderableRelationships:
        - relationshipName: user
  graphql:
    expressionTypeName: orders_order_by_exp

---
kind: Model
version: v2
definition:
  name: orders
  objectType: orders
  source:
    dataConnectorName: mypostgres
    collection: orders
  filterExpressionType: orders_bool_exp
  aggregateExpression: orders_agg_exp
  orderByExpression: orders_order_by_exp
  graphql:
    selectMany:
      queryRootField: orders
      subscription:
        rootField: orders
    selectUniques:
      - queryRootField: orders_by_order_id
        uniqueIdentifier:
          - order_id
        subscription:
          rootField: orders_by_order_id
    filterInputTypeName: orders_filter_input
    aggregate:
      queryRootField: orders_aggregate
      subscription:
        rootField: orders_aggregate

---
kind: ModelPermissions
version: v1
definition:
  modelName: orders
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

---
kind: Relationship
version: v1
definition:
  name: orderitems
  sourceType: orders
  target:
    model:
      name: orderitems
      relationshipType: Array
      aggregate:
        aggregateExpression: orderitems_agg_exp
  mapping:
    - source:
        fieldPath:
          - fieldName: order_id
      target:
        modelField:
          - fieldName: order_id
  graphql:
    aggregateFieldName: orderitems_aggregate

---
kind: Relationship
version: v1
definition:
  name: user
  sourceType: orders
  target:
    model:
      name: users
      relationshipType: Object
  mapping:
    - source:
        fieldPath:
          - fieldName: user_id
      target:
        modelField:
          - fieldName: user_id

